# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-long-random-secret-min-32-chars

# Admin bootstrap (first account with this email becomes admin)
ADMIN_EMAIL=

# Branding (all configurable, also editable in Admin Settings)
BRAND_NAME=CareerSignal
SUPPORT_EMAIL=support@example.com
COMPANY_NAME=CareerSignal Inc.
COMPANY_ADDRESS=
DEFAULT_CURRENCY=USD

# Payments (leave empty to run in safe development test mode)
PAYMENTS_MODE=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Email provider (leave empty for built-in development inbox; set RESEND_API_KEY or SMTP to send real mail)
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI provider (leave empty to use the built-in local intelligence engine)
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Demo seed data (development only, never enabled in production)
SEED_DEMO=false
